## Step 7: Build the Controller Layer
Expose two endpoints: one to seed test data quickly, and one to fetch your custom Criteria-based projection.

package net.guides.springboot.jpa.controller;
import net.guides.springboot.jpa.dto.InstructorSummaryDTO;import net.guides.springboot.jpa.model.Instructor;import net.guides.springboot.jpa.model.InstructorDetail;import net.guides.springboot.jpa.repository.InstructorRepository;import org.springframework.web.bind.annotation.*;
import java.util.List;

@RestController
@RequestMapping("/api/instructors")public class InstructorController {

    private final InstructorRepository instructorRepository;

    public InstructorController(InstructorRepository instructorRepository) {
        this.instructorRepository = instructorRepository;
    }

    // Endpoint to seed dummy database rows
    @PostMapping("/seed")
    public String seedData() {
        Instructor inst1 = new Instructor("David", "Gilmore", "david@gmail.com");
        inst1.addInstructorDetail(new InstructorDetail("dave", "hiking"));
        inst1.addInstructorDetail(new InstructorDetail("gilmore", "singing"));

        Instructor inst2 = new Instructor("Roger", "Waters", "roger@gmail.com");
        inst2.addInstructorDetail(new InstructorDetail("rogerTV", "hiking"));

        instructorRepository.save(inst1);
        instructorRepository.save(inst2);

        return "Database seeded successfully!";
    }

    // Endpoint testing Criteria API + Projection
    @GetMapping("/summary")
    public List<InstructorSummaryDTO> getSummariesByHobby(@RequestParam String hobby) {
        return instructorRepository.findInstructorSummariesByHobby(hobby);
    }
}

